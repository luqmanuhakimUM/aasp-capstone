# --- Core ---
# Defaults to a local SQLite file if unset -- fine for local dev/testing with
# zero external services. Point at Postgres (with the pgvector extension
# available) for anything closer to production:
# DATABASE_URL=postgresql+psycopg://aasp:aasp@localhost:5432/aasp
DATABASE_URL=sqlite:///./aasp_dev.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
STORAGE_DIR=./storage

# --- LLM (required for Research Discovery, Integrity Advisor, Writing Support, Source Organiser) ---
# Local via Ollama -- no API key, no cost. Install Ollama, run `ollama serve`
# (usually starts automatically), then `ollama pull llama3.1:8b` (or another
# model of your choice -- update OLLAMA_MODEL to match).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Open-access literature APIs (all free, no key required for prototype rate limits) ---
SEMANTIC_SCHOLAR_API_KEY=
CORS_ORIGINS=http://localhost:3000

# --- Google sign-in (optional -- "Continue with Google" hides itself on the
# frontend until both of these are set). Create a Web application OAuth
# client at https://console.cloud.google.com/apis/credentials and add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3000
